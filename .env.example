# Specify location of langflow configuration directory (.langflow/)
LANGFLOW_CONFIG_DIR=./.langflow

# Save langflow.db in the configuration directory (.langflow/langflow.db)
LANGFLOW_SAVE_DB_IN_CONFIG_DIR=True

# Sync `langflow.db` with flows/ components/
# LANGFLOW_LOAD_FLOWS_PATH=./flows
LANGFLOW_COMPONENTS_PATH=./components

# Enable autosave
LANGFLOW_AUTO_SAVING=True

# Ask langflow not to track usage data
DO_NOT_TRACK=True

# Specify logging environment
LANGFLOW_LOG_ENV=container

# Disable automatic MCP server configuration for new projects
LANGFLOW_ADD_PROJECTS_TO_MCP_SERVERS=False