# Environment Variables
# ===== Update me ======
MODEL_NAME=
BASE_URL=
API_KEY=
# ======================

# Vector Store persistance path for Chroma DB
VECTOR_STORE_PERSISTANCE_PATH=./data/databases/chroma_db

# Get Langflow global variables from environment variables
LANGFLOW_VARIABLES_TO_GET_FROM_ENVIRONMENT=MODEL_NAME,BASE_URL,API_KEY,VECTOR_STORE_PERSISTANCE_PATH

# Specify location of langflow configuration directory (langflow_db/)
LANGFLOW_CONFIG_DIR=./data/databases/langflow_db

# Save langflow.db in the configuration directory (langflow_db/)
LANGFLOW_SAVE_DB_IN_CONFIG_DIR=True

# Sync `langflow.db` with flows/
LANGFLOW_LOAD_FLOWS_PATH=./flows

# Enable autosave
LANGFLOW_AUTO_SAVING=True

# Ask langflow not to track usage data
DO_NOT_TRACK=True

# Disable automatic MCP server configuration for new projects
LANGFLOW_ADD_PROJECTS_TO_MCP_SERVERS=False

# Authentication
LANGFLOW_AUTO_LOGIN=True

# Disable starter projects
# LANGFLOW_CREATE_STARTER_PROJECTS=